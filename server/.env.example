# Optional: pre-fill the username shown in the UI
LICHESS_USERNAME=

# Optional: a Lichess personal API token (https://lichess.org/account/oauth/token,
# scope game:read). Not required for public games, but raises your rate limit
# and lets you fetch your own private/unlisted games if you have any.
# NEVER commit this file with a real token in it.
LICHESS_TOKEN=

# Path to the Stockfish binary if it's not on PATH
# STOCKFISH_PATH=/usr/games/stockfish

STOCKFISH_DEPTH=14

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
